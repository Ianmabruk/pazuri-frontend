PORT=4000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/serve_db?schema=public

# Mailtrap email configuration
EMAIL_PROVIDER=mailtrap
MAILTRAP_API_KEY=replace-with-mailtrap-api-key
MAILTRAP_SENDER_EMAIL=hello@yourdomain.com
MAILTRAP_SENDER_NAME="Your Business Name"

# SMS provider configuration (backend-only, optional until approved)
# Supported providers: none, twilio, brevo
SMS_PROVIDER=none
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_API_KEY=
SMS_SENDER_ID=
